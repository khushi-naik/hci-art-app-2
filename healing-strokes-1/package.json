{
  "name": "healing-strokes",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "next build && esbuild server.ts --platform=node --packages=external --bundle --format=cjs --outfile=build/server.cjs",
    "start": "NODE_ENV=production node build/server.cjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "test:e2e:production": "E2E_PRODUCTION=1 playwright test"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "konva": "^10.0.0",
    "react-konva": "^19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.0.0",
    "@next/env": "^16.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "esbuild": "^0.28.2",
    "vitest": "^5.0.4",
    "eslint": "^9.0.0",
    "@playwright/test": "^1.56.0",
    "typescript-eslint": "^8.60.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "@eslint/js": "^9.39.0",
    "prettier": "^3.6.0"
  }
}
